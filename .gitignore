# Secrets and credentials (PO Dashboard stores mailbox secrets in the macOS Keychain, never in a file)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
.envrc
credentials*.json
client_secret*.json
token*.json
*secret*.json
*.token
.netrc
id_rsa*

# Real vendor documents: never committed (DEC-13). Synthetic test data lives in tests/data/.
real-docs/
inbox-samples/
*.eml.real
.DS_Store

# Exports and scratch that the project does not use
*.xlsx
!tests/data/**/*.xlsx
*.numbers
*.docx
!tests/data/**/*.docx
*.zip
scratch/

# Test-cycle workbooks hold a tester's results and signature; they stay on this Mac (owner, 2026-11-07)
test-evidence/workbooks/

# Laptop-only notes
LEARNING_JOURNAL.md

